# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=              # Anthropic API key for LLM pipeline stages
SESSION_SECRET=change-me-to-a-long-random-string   # REQUIRED — Flask session signing key

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                 # Resend API key; leave blank for dev (magic links redirect directly)

# ── Optional / defaults shown ─────────────────────────────────────────────────
DEEPL_API_KEY=                  # DeepL API key for translation (falls back to Haiku if blank)
APP_URL=https://yourapp.pythonanywhere.com   # Base URL used in magic-link and digest emails
APPROVAL_SECRET=change-me       # HMAC secret for approval + unsubscribe tokens
FEED_DIR=feeds/brake-by-wire    # Path to the feed bundle directory
DB_PATH=niche.db                # SQLite database path (use absolute path on PythonAnywhere)
SCHEDULER_ENABLED=false         # Set to "true" on PythonAnywhere always-on worker
